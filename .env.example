DATABASE_URL="mysql://user:password@127.0.0.1:3306/physics"
JWT_SECRET="replace-with-at-least-32-random-characters"
SETTINGS_ENCRYPTION_KEY="replace-with-a-different-32-character-random-secret"

# Optional: only used by `npm run db:seed` to create an initial admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional sample faculty account; created only when explicitly enabled.
SEED_SAMPLE_FACULTY="false"
SAMPLE_FACULTY_EMAIL=""
SAMPLE_FACULTY_PASSWORD=""

# One-off faculty reset script inputs. Never commit real values.
RESET_FACULTY_EMAIL=""
RESET_FACULTY_PASSWORD=""

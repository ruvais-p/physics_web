# ==============================================================================
# Environment Configuration for Physics Department Web Portal
# Copy this file to .env (or .env.production) and fill in your secure secrets.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database Credentials (used by Docker Compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=physics_db

# Prisma Database Connection URL
# When running with Docker Compose, 'db' is the hostname of the PostgreSQL container
DATABASE_URL="postgresql://postgres:replace-with-a-strong-postgres-password@db:5432/physics_db?schema=public&connection_limit=10"
PRISMA_CLIENT_ENGINE_TYPE="binary"

# Application Security Secrets
# IMPORTANT: Both secrets MUST be generated independently and be AT LEAST 32 characters long.
# Use: openssl rand -base64 32 (or a cryptographically secure generator)
JWT_SECRET="replace-with-at-least-32-character-random-secret"
SETTINGS_ENCRYPTION_KEY="replace-with-a-different-32-character-random-secret"
